# === Required ===
JWT_SECRET=change-me-to-a-random-string

# === AI (optional, for natural language policy setup) ===
# ANTHROPIC_API_KEY=sk-ant-...

# === Database (defaults work with docker-compose) ===
# DATABASE_URL=postgresql+asyncpg://letagentpay:letagentpay@localhost:5434/letagentpay

# === Redis (defaults work with docker-compose) ===
# REDIS_URL=redis://localhost:6380

# === Email (optional, magic links logged to console without it) ===
# RESEND_API_KEY=re_...
# EMAIL_FROM=LetAgentPay <noreply@letagentpay.com>

# === Web Push (optional) ===
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=admin@letagentpay.com

# === Telegram (optional, enables Telegram notifications) ===
# TELEGRAM_BOT_TOKEN=         # Create a bot via @BotFather, paste token here
# TELEGRAM_ADMIN_CHAT_ID=     # Chat ID for internal monitoring (new signups etc.)
# TELEGRAM_ALERT_CHAT_ID=     # Chat ID for backup/monitoring alerts

# === Backups (optional, off-site to Cloudflare R2 via rclone) ===
# R2_BUCKET_NAME=lap1

# === Stripe (optional, billing disabled without it) ===
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# PRO_PRICE=0

# === Admin (optional, comma-separated emails) ===
# ADMIN_EMAILS=admin@example.com

# === Self-hosted mode ===
# SELF_HOSTED=false
# ADMIN_PASSWORD=          # Password login instead of magic link (self-hosted only)

# === Cookie ===
# COOKIE_SECURE=false

# === CORS ===
# FRONTEND_URL=http://localhost:3000
