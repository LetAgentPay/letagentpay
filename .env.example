# === Required ===
JWT_SECRET=change-me-to-a-random-string

# === AI (optional, for natural language policy setup) ===
# ANTHROPIC_API_KEY=sk-ant-...

# === Database (defaults work with docker-compose) ===
# DATABASE_URL=postgresql+asyncpg://letagentpay:letagentpay@localhost:5434/letagentpay

# === Redis (defaults work with docker-compose) ===
# REDIS_URL=redis://localhost:6380

# === Email (optional, magic links logged to console without it) ===
# RESEND_API_KEY=re_...
# EMAIL_FROM=LetAgentPay <noreply@letagentpay.com>

# === Web Push (optional) ===
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=admin@letagentpay.com

# === Self-hosted mode ===
SELF_HOSTED=true
# ADMIN_PASSWORD=          # Password login instead of magic link (self-hosted only)

# === Cookie ===
# COOKIE_SECURE=false

# === CORS ===
# FRONTEND_URL=http://localhost:3000
